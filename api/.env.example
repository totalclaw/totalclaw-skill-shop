# 复制为 api/.env 并按需修改
NODE_ENV=development
PORT=3091

# MongoDB —— 与 totalclaw-web 共享同一个库：totalclaw
#   · 独立本地开发（仅 skill-shop，自带 mongo）：mongodb://127.0.0.1:27018/totalclaw
#   · 与 web 共享本地库（web 的 mongo 在 27017）：mongodb://127.0.0.1:27017/totalclaw
#   · 线上生产（与 web 共用，token-web 容器内）：mongodb://127.0.0.1:27117/totalclaw?directConnection=true
MONGODB_URI=mongodb://127.0.0.1:27018/totalclaw

# JWT
JWT_SECRET=change-me-skill-market-jwt
JWT_EXPIRES_IN=30d

# 支付 webhook HMAC 密钥（pay-webhook 验签用，仿 totalclaw-web）
SKILL_PAY_INTERNAL_TOKEN=change-me-internal-token

# 平台抽成比例（开发者付费 skill 分账）
PLATFORM_FEE_RATE=0.3

# 管理员引导账号（首次启动建管理员）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# === 与 totalclaw-web 共用账号/登录态（SSO）===
# JWT_SECRET 必须与 web 的 JWT_SECRET 一致（deploy 会自动从 web 读取覆盖）
# WEB_AUTH_BASE  web 登录 API（线上默认 http://127.0.0.1:3000/api）
# COOKIE_DOMAIN  跨子域 cookie 父域（如 .taituai.com；deploy 自动按域名推导）
# COOKIE_SECURE  1=仅 HTTPS 下发 cookie（有证书时 deploy 置 1）
WEB_AUTH_BASE=http://127.0.0.1:3000/api
COOKIE_DOMAIN=
COOKIE_SECURE=1
