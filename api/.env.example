# 复制为 api/.env 并按需修改
NODE_ENV=development
PORT=3091

# MongoDB（docker-compose 暴露在 27018，库 skill-market）
MONGODB_URI=mongodb://127.0.0.1:27018/skill-market

# JWT
JWT_SECRET=change-me-skill-market-jwt
JWT_EXPIRES_IN=30d

# 支付 webhook HMAC 密钥（pay-webhook 验签用，仿 totalclaw-web）
SKILL_PAY_INTERNAL_TOKEN=change-me-internal-token

# 平台抽成比例（开发者付费 skill 分账）
PLATFORM_FEE_RATE=0.3

# 管理员引导账号（首次启动建管理员）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
