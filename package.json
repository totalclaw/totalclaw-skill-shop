{
  "name": "totalclaw-skill-shop",
  "private": true,
  "version": "0.1.0",
  "description": "TotalClaw Skill 市场 — 多源聚合 + 收费交易（Express SSR 前台 + NestJS API + MongoDB）",
  "scripts": {
    "start": "node server/index.js",
    "start:local": "bash scripts/start-local.sh",
    "dev": "NODE_ENV=development node server/index.js",
    "sync": "node scripts/sync/run-sync.js",
    "sync:local": "node scripts/sync/run-sync.js --source=totalclaw,openclaw,hermes",
    "api:dev": "cd api && npm run start:dev",
    "api:build": "cd api && npm run build",
    "api:start": "cd api && npm run start:prod",
    "mongo:up": "docker compose up -d",
    "mongo:down": "docker compose down",
    "pm2:start": "npx pm2 start ecosystem.config.cjs",
    "pm2:reload": "npx pm2 reload ecosystem.config.cjs --update-env",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "deploy": "bash scripts/deploy-pm2.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "mongodb": "^6.12.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "pm2": "^5.4.3"
  }
}
